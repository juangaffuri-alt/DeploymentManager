<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<add key="BpnPackages" value="https://pkgs.dev.azure.com/Banco-Provincia-Neuquen/_packaging/Packages/nuget/v3/index.json" />
	</packageSources>
	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
		<packageSource key="BpnPackages">
			<package pattern="Bpn.*" />
		</packageSource>
	</packageSourceMapping>
</configuration>