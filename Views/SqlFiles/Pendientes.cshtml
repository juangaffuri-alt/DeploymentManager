@using X.PagedList.Mvc.Core
@using X.PagedList;
@using X.PagedList.Mvc.Core.Fluent;
@using PasadorScript.Helpers;
@using PasadorScript.Services.Azure;
@using PasadorScript.Services.Graph;
@using System.Text.Encodings.Web;
@inject PasadorScript.Services.AdGroups.IAdGroupService _adGroupService;
@section Styles {
    <style>
        .gap-2 {
            gap: 0.5rem;
        }

        .status-icon {
            font-size: 1.15rem;
            line-height: 1;
        }

        .status-icon-success { color: #31CE36 !important; }
        .status-icon-danger { color: #F25961 !important; }
        .status-icon-primary { color: #1572E8 !important; }
        .status-icon-warning { color: #FFAD46 !important; }
        .status-icon-secondary { color: #6861CE !important; }
        .status-icon-muted { color: #8492a6 !important; }

        .status-cell,
        .statusP-cell,
        .statusbuild-cell {
            width: 2.25rem;
            text-align: center;
            white-space: nowrap;
            vertical-align: middle;
        }

        .app-mark-bantotal {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.2rem 0.55rem;
            border-radius: 999px;
            background: #fff;
            color: #0f766e;
            border: 1px solid #0f766e;
            font-weight: 600;
            font-size: 0.75rem;
            line-height: 1.2;
            white-space: nowrap;
        }

        .table > tbody > tr.fila-bantotal > td {
            --bs-table-bg-type: #b7efe8;
            --bs-table-bg-state: #b7efe8;
            --bs-table-accent-bg: #b7efe8;
            background-color: #b7efe8 !important;
            box-shadow: none;
        }

        .table > tbody > tr.fila-bantotal > td:first-child {
            box-shadow: inset 4px 0 0 #0f766e;
        }

        .table-hover > tbody > tr.fila-bantotal:hover > td {
            --bs-table-bg-type: #8fe3d8;
            --bs-table-bg-state: #8fe3d8;
            --bs-table-accent-bg: #8fe3d8;
            background-color: #8fe3d8 !important;
        }

        .table-hover > tbody > tr.fila-bantotal:hover > td:first-child {
            box-shadow: inset 4px 0 0 #0f766e;
        }
    </style>
}
@model PasadorScript.ViewModels.SearchScripts
@{
    ViewData["Title"] = "Scripts T-SQL";
    var log = await _adGroupService.GetInfoUser();
    var esIyC = log.Roles.Any(x => x.GroupName == "IYC");
}

<form method="get" asp-action="Pendientes">
    <input type="hidden" name="usuarioExplicit" value="true" />
    <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row pt-2 pb-4">
        <div>
            <h3 class="fw-bold mb-3">Scripts</h3>
            <h6 class="op-7 mb-2">Pasaje a QA y PROD de scripts <strong>con deploy activo y pendientes de aprobación</strong></h6>
        </div>
        <div class="ms-md-auto py-2 py-md-0">
            <a asp-action="AddNewScript" class="btn btn-secondary">
                <span class="btn-label">
                    <i class="fa fa-plus"></i>
                </span>
                Agregar script
            </a>
            <!-- Botón para actualizar manualmente - inicialmente deshabilitado -->
            <button type="button" id="btnActualizarEstados" class="btn btn-info ms-2" disabled>
                <span class="btn-label">
                    <i class="fas fa-sync-alt"></i>
                </span>
                <span id="btnTexto">Cargando estados...</span>
            </button>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Scripts T-SQL</h4>
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md">
                            <div class="form-group mb-0">
                                <label asp-for="RepositoryId" class="form-label"></label>
                                <select asp-for="RepositoryId" asp-items="ViewBag.Aplicativos" class="form-control">
                                    <option value="TODOS">TODOS</option>
                                </select>
                                <span asp-validation-for="RepositoryId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-12 col-md">
                            <div class="form-group mb-0">
                                <label asp-for="Usuario" class="form-label"></label>
                                <div class="input-icon">
                                    <span class="input-icon-addon">
                                        <i class="fa fa-user"></i>
                                    </span>
                                    <input type="text" class="form-control" placeholder="Usuario AD" asp-for="Usuario" autocomplete="off">
                                    <div id="sugerencias" class="dropdown-menu w-100"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md">
                            <div class="form-group mb-0">
                                <label asp-for="Descripcion" class="form-label"></label>
                                <input type="text" class="form-control" asp-for="Descripcion">
                            </div>
                        </div>
                        <div class="col-12 col-md">
                            <div class="form-group mb-0">
                                <label class="form-label" asp-for="NroIncidente">Referencia</label>
                                <input asp-for="NroIncidente" type="number" min="1" class="form-control" placeholder="Nro" />
                            </div>
                        </div>
                        <div class="col-12 col-md">
                            <div class="form-group mb-0">
                                <label class="form-label d-none d-md-block">&nbsp;</label>
                                <button class="btn btn-primary w-100" id="btnBuscar" type="submit">
                                    <span class="btn-label">
                                        <i class="fas fa-search"></i>
                                    </span>
                                    Filtrar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body">

                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-compact">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Analista</th>
                                    <th>Fecha</th>
                                    <th>Descripción</th>
                                    <th>Aplicación</th>
                                    <th>Referencia</th>
                                    <th>Build</th>
                                    @foreach (var e in Model.Environments.Where(X => X.Visible))
                                    {
                                        <th>@e.Name</th>
                                    }
                                    <th></th>
                                </tr>
                            </thead>
                            @if (Model.Resultado.Any())
                            {
                                <tbody>
                                    @foreach (var s in Model.Resultado)
                                    {
                                        var title = "";
                                        var esBantotal = esIyC && string.Equals(s.Aplicacion, "Bantotal", StringComparison.OrdinalIgnoreCase);
                                        if (s.PullRequestIdQa.HasValue && s.PullRequestIdQa.Value != 0)
                                        {
                                            title = $"PullRequestId: {s.PullRequestIdQa.Value}";
                                        }
                                        <tr data-pr-id="@s.PullRequestIdQa" class="@(esBantotal ? "fila-bantotal" : null)">
                                            <td title="@title">@s.IdScript</td>
                                            <td>@s.Usuario</td>
                                            <td>@s.FechaCreacion.ToShortDateString()</td>
                                            <td title="@s.Descripcion">@(s.IsHotfix ? Html.Raw("<i class='fas fa-bolt status-icon status-icon-danger me-1' title='Hotfix' aria-label='Hotfix'></i>") : "")@s.DescripcionShort</td>
                                            <td>
                                                @if (esBantotal)
                                                {
                                                    <span class="app-mark-bantotal" title="Bantotal">
                                                        <i class="fas fa-university" aria-hidden="true"></i> Bantotal
                                                    </span>
                                                }
                                                else
                                                {
                                                    @s.Aplicacion
                                                }
                                            </td>
                                            <td><span class="badge badge-primary">@s.TipoCambioDescripcion @s.NroIncidente</span></td>
                                            <td id="status-@s.PullRequestIdQa" class="status-cell" data-idpr="@s.PullRequestIdQa">
                                                <i class="fas fa-clock status-icon status-icon-muted" title="no iniciado" aria-label="no iniciado"></i>
                                            </td>
                                            @foreach (var e in Model.Environments.Where(X => X.AzureProjectType.ToLower() == s.AzureProjectType.ToLower()))
                                            {
                                                <td id="statusP-@s.PullRequestIdQa-@e.Id" class="statusP-cell" data-idpr="@s.PullRequestIdQa" data-envid="@e.Id" data-env-name="@e.Name">
                                                    <i class="fas fa-clock status-icon status-icon-muted" title="no iniciado" aria-label="no iniciado"></i>
                                                </td>
                                            }
                                            <td>
                                                <div class="btn-group dropdown">
                                                    <button class="btn btn-link btn-sm text-muted p-1"
                                                            type="button"
                                                            data-bs-toggle="dropdown"
                                                            title="Acciones"
                                                            aria-label="Acciones">
                                                        <i class="fas fa-ellipsis-v"></i>
                                                    </button>
                                                    <ul class="dropdown-menu" role="menu">
                                                        @if ((s.PullRequestIdQa == null || s.PullRequestIdQa.Value == 0) && s.Usuario == log?.Username)
                                                        {
                                                            <li>
                                                                <a asp-action="Edit" asp-route-idCambio="@s.IdScript"
                                                                   data-bs-toggle="tooltip"
                                                                   title="Editar"
                                                                   class="dropdown-item"
                                                                   data-original-title="Editar">
                                                                    <i class="fa fa-edit"></i> Editar
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <button asp-action="delete" asp-route-id="@s.IdScript"
                                                                        data-bs-toggle="tooltip" data-id="@s.IdScript"
                                                                        title="Eliminar"
                                                                        class="dropdown-item delete-link"
                                                                        data-original-title="Eliminar">
                                                                    <i class="fa fa-trash"></i> Eliminar
                                                                </button>
                                                            </li>
                                                        }
                                                        else
                                                        {
                                                            <li>
                                                                <a asp-action="Vote" asp-route-idCambio="@s.IdScript"
                                                                   data-bs-toggle="tooltip"
                                                                   title="Ver archivos"
                                                                   class="dropdown-item"
                                                                   data-original-title="Ver archivos">
                                                                    <i class="fa fa-code-branch"></i> Promover
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a asp-action="EstadoPullRequestScripts" asp-controller="PullRequest" asp-route-prId="@s.PullRequestIdQa"
                                                                   data-bs-toggle="tooltip"
                                                                   title="Estado PR"
                                                                   class="dropdown-item"
                                                                   data-original-title="Estado">
                                                                    <i class="fas fa-cogs"></i> Estado PR
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a asp-action="ViewStatus" asp-route-id="@s.PullRequestIdQa!.Value" asp-route-projectType="@s.AzureProjectType" asp-controller="Release"
                                                                   data-bs-toggle="tooltip"
                                                                   title="Release"
                                                                   class="dropdown-item"
                                                                   data-original-title="Aprobar">
                                                                    <i class="fa fa-rocket"></i> Estado deploy
                                                                </a>
                                                            </li>
                                                            @Html.CompartirEstadoTeams(s.PullRequestIdQa, s.AzureProjectType)
                                                            <li>
                                                                <a asp-action="RedirectToAudit"
                                                                   asp-controller="SqlFiles"
                                                                   asp-route-idScript="@s.IdScript"
                                                                   data-bs-toggle="tooltip"
                                                                   title="Ver Historial"
                                                                   class="dropdown-item"
                                                                   data-original-title="Historial">
                                                                    <i class="fa fa-history"></i> Historial
                                                                </a>
                                                            </li>
                                                        }
                                                        <li>
                                                            <a asp-action="ViewFiles" asp-route-idCambio="@s.IdScript"
                                                               data-bs-toggle="tooltip"
                                                               title="Ver archivos"
                                                               class="dropdown-item"
                                                               data-original-title="Ver archivos">
                                                                <i class="fa fa-code"></i> Ver
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            }
                            else
                            {
                                <tbody id="tablaBody">
                                    <tr id="filaVacia">
                                        <td colspan="9" class="text-center text-muted">No se han encontrado registros.</td>
                                    </tr>
                                </tbody>
                            }
                        </table>
                        @Html.PagedListPager(Model.Resultado, page => Url.Action("Pendientes", new
                        {
                            page,
                            descripcion = Model.Descripcion,
                            idEstado = Model.IdEstado,
                            repositoryId = Model.RepositoryId,
                            usuario = Model.Usuario ?? string.Empty,
                            usuarioExplicit = UsuarioFiltroHelper.FlagPaginacion(Model.Usuario),
                            nroIncidente = Model.NroIncidente
                        }), new X.PagedList.Mvc.Core.PagedListRenderOptions
                        {
                            LiElementClasses = new string[] { "page-item" },
                            PageClasses = new string[] { "page-link" },
                            ActiveLiElementClass = "active",
                            UlElementClasses = new List<string> { "pagination pg-primary" }
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/sqlFilesEnvStatus.js" asp-append-version="true"></script>
    <script>
        const stageBuckets = @Html.Raw(Json.Serialize(Model.StageBuckets));
        const input = document.getElementById("Usuario");
        const sugerencias = document.getElementById("sugerencias");
        const btnActualizarEstados = document.getElementById('btnActualizarEstados');
        const btnTexto = document.getElementById('btnTexto');

        // Función para habilitar el botón de actualizar
        function habilitarBotonActualizar() {
            if (btnActualizarEstados && btnTexto) {
                btnActualizarEstados.disabled = false;
                btnTexto.textContent = 'Actualizar estados';
                btnActualizarEstados.classList.remove('btn-secondary');
                btnActualizarEstados.classList.add('btn-info');
                console.log('Botón de actualizar habilitado');
            }
        }

        // Función para deshabilitar el botón de actualizar durante una operación
        function deshabilitarBotonActualizar(texto) {
            if (btnActualizarEstados && btnTexto) {
                btnActualizarEstados.disabled = true;
                btnTexto.textContent = texto || 'Procesando...';
                btnActualizarEstados.classList.remove('btn-info');
                btnActualizarEstados.classList.add('btn-secondary');
            }
        }

        // Configuración - SIN POLLING AUTOMÁTICO
        const ACTIVE_STATUSES = ['queued', 'inprogress', 'inProgress', 'active', 'pending'];

        // Mapeo de estados a iconos
        const statusIcons = {
            'queued': 'fas fa-hourglass-half',
            'inProgress': 'fas fa-sync-alt',
            'inprogress': 'fas fa-sync-alt',
            'active': 'fas fa-sync-alt',
            'completed': 'fas fa-check-circle',
            'succeeded': 'fas fa-check-circle',
            'failed': 'fas fa-times-circle',
            'canceled': 'fas fa-ban',
            'rejected': 'fas fa-times-circle',
            'rejectado': 'fas fa-times-circle',
            'pending': 'fas fa-clock',
            'notstarted': 'fas fa-hourglass-start',
            'abandoned': 'fas fa-ban'
        };

        function statusColorClass(badgeClass, status) {
            const c = (badgeClass || '').toLowerCase();
            const s = (status || '').toLowerCase();
            if (c.includes('success') || ['completed', 'succeeded', 'success', 'merged'].some(x => s.includes(x)))
                return 'status-icon-success';
            if (c.includes('danger') || ['fail', 'reject', 'cancel', 'abandon'].some(x => s.includes(x)))
                return 'status-icon-danger';
            if (c.includes('warning') || ['partial', 'notdeploy'].some(x => s.includes(x)))
                return 'status-icon-warning';
            if (c.includes('primary') || ['progress', 'active', 'queued', 'inprogress'].some(x => s.includes(x)))
                return 'status-icon-primary';
            if (c.includes('secondary') || c.includes('info'))
                return 'status-icon-secondary';
            return 'status-icon-muted';
        }

        // Icono de estado con color (sin badge); texto en title/aria-label
        function updateBadge(element, status, badgeClass, statusLabel) {
            if (!element) return;

            const statusLower = (status || '').toLowerCase();
            const iconClass = statusIcons[statusLower] || 'fas fa-question-circle';
            const needsSpin = ACTIVE_STATUSES.includes(statusLower);
            const label = (statusLabel || status || 'no iniciado').replace(/"/g, '&quot;');
            const colorClass = statusColorClass(badgeClass, status);

            element.innerHTML = `<i class="${iconClass} ${needsSpin ? 'fa-spin' : ''} status-icon ${colorClass}" title="${label}" aria-label="${label}"></i>`;
        }
        // Función para actualizar un PR específico
        async function updatePrStatus(prId, forceRefresh = false) {
            if (!prId || prId.id == 0) return false;

            try {
                const url = `/PullRequest/GetStatus?prId=${prId.id}&projectType=${prId.projectType}&forceRefresh=${forceRefresh}`;
                const prResponse = await fetch(url);
                if (prResponse.ok) {
                    const pr = await prResponse.json();
                    const cell = document.getElementById(`status-${prId.id}`);
                    if (cell) {
                        updateBadge(cell, pr.pullRequestStatus, pr.prStatusBadgeClass, pr.pullRequestStatus);
                        return true;
                    }
                }
            } catch (error) {
                console.error(`Error obteniendo estado PR ${prId.id}:`, error);
            }
            return false;
        }

        // Función para actualizar releases de un PR
        async function updatePrReleases(prId, forceRefresh = false) {
            if (!prId || prId.id == 0) return false;

            try {
                const url = `/PullRequest/GetReleasesSctiptsByPr?prId=${prId.id}&projectType=${prId.projectType}&forceRefresh=${forceRefresh}`;
                const releasesResponse = await fetch(url);
                if (releasesResponse.ok) {
                    const release = await releasesResponse.json();
                    if (release && release.environments) {
                        let success = false;
                        release.environments.forEach(env => {
                            const envCell = findEnvCell(prId.id, env, stageBuckets);
                            if (envCell) {
                                updateBadge(envCell, env.status, env.statusBadgeLabel, env.statusLabel);
                                success = true;
                            }
                        });
                        return success;
                    }
                }
            } catch (error) {
                console.error(`Error obteniendo releases PR ${prId.id}:`, error);
            }
            return false;
        }

        // Función para actualizar un PR completo (estado + releases)
        async function updatePr(prId, forceRefresh = false) {
            if (!prId || prId == 0) return false;

            try {
                const prSuccess = await updatePrStatus(prId, forceRefresh);
                const releasesSuccess = await updatePrReleases(prId, forceRefresh);
                return prSuccess || releasesSuccess;
            } catch (error) {
                console.error(`Error actualizando PR ${prId}:`, error);
                return false;
            }
        }

        // Modificar actualizarTodosEstados para forzar refresh
        async function actualizarTodosEstados() {
            if (!btnActualizarEstados) return;

            // Deshabilitar botón durante la actualización
            deshabilitarBotonActualizar('Actualizando...');

            try {
                const prIds = [];
                @foreach (var s in Model.Resultado.Where(s => s.PullRequestIdQa.HasValue && s.PullRequestIdQa.Value > 0))
                {
                                        <text>
                                                    prIds.push({ id: @s.PullRequestIdQa, projectType: "@s.AzureProjectType" });
                                        </text>
                }

                if (prIds.length === 0) {
                    habilitarBotonActualizar();
                    return;
                }

                // Actualizar forzando refresh de caché
                let actualizados = 0;
                for (const prId of prIds) {
                    try {
                        await updatePr(prId, true); // <- forceRefresh = true
                        actualizados++;

                        // Pequeña pausa entre solicitudes
                        if (actualizados <prIds.length) {
                            await new Promise(resolve => setTimeout(resolve, 100));
                        }
                    } catch (error) {
                        console.error(`Error actualizando PR ${prId}:`, error);
                    }
                }

                // Mostrar notificación
                if (actualizados> 0) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Estados actualizados',
                        text: `Se actualizaron ${actualizados} PRs correctamente`,
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
            } catch (error) {
                console.error('Error actualizando estados:', error);
                Swal.fire('Error', 'No se pudieron actualizar los estados', 'error');
            } finally {
                habilitarBotonActualizar();
            }
        }

        // Función para carga inicial ÚNICA (sin polling)
        async function cargaInicialEstados() {
            const prIds = [];
            @foreach (var s in Model.Resultado.Where(s => s.PullRequestIdQa.HasValue && s.PullRequestIdQa.Value > 0))
            {
                                <text>
                                                    prIds.push({ id: @s.PullRequestIdQa, projectType: "@s.AzureProjectType" });
                                </text>
            }

            if (prIds.length === 0) {
                // No hay PRs para cargar, habilitar el botón de inmediato
                habilitarBotonActualizar();
                console.log('No hay PRs para cargar inicialmente');
                return;
            }

            console.log(`Carga inicial de ${prIds.length} PRs...`);

            try {
                // Actualizar en lotes pequeños para no sobrecargar
                const batchSize = 3;
                let totalCargados = 0;

                for (let i = 0; i <prIds.length; i += batchSize) {
                    const batch = prIds.slice(i, i + batchSize);
                    const resultados = await Promise.allSettled(batch.map(prId => updatePr(prId)));

                    totalCargados += resultados.filter(r => r.status === 'fulfilled' && r.value).length;

                    // Actualizar texto del botón con progreso
                    if (btnTexto) {
                        const porcentaje = Math.round((totalCargados / prIds.length) * 100);
                        btnTexto.textContent = `Cargando... ${porcentaje}%`;
                    }

                    // Pequeña pausa entre lotes
                    if (i + batchSize <prIds.length) {
                        await new Promise(resolve => setTimeout(resolve, 300));
                    }
                }

                console.log(`Carga inicial completada: ${totalCargados}/${prIds.length} PRs cargados`);

            } catch (error) {
                console.error('Error en carga inicial:', error);
            } finally {
                // Habilitar el botón cuando termine la carga inicial (éxito o error)
                habilitarBotonActualizar();
            }
        }

        // Autocomplete para usuario
        input.addEventListener("input", async function () {
            let query = this.value;
            if (query.length <2) {
                sugerencias.classList.remove("show");
                sugerencias.innerHTML = "";
                return;
            }

            const response = await fetch(`/RuntimeHelper/BuscarUsuario?term=${encodeURIComponent(query)}&tablasType=${@((int)PasadorScript.Helpers.TablasType.Scripts)}`);
            const data = await response.json();

            if (data.length === 0) {
                sugerencias.classList.remove("show");
                sugerencias.innerHTML = "";
                return;
            }

            sugerencias.innerHTML = "";
            data.forEach(item => {
                const a = document.createElement("a");
                a.classList.add("dropdown-item");
                a.href = "#";
                a.textContent = item;
                a.onclick = (e) => {
                    e.preventDefault();
                    input.value = item;
                    sugerencias.classList.remove("show");
                    sugerencias.innerHTML = "";
                };
                sugerencias.appendChild(a);
            });

            sugerencias.classList.add("show");
        });

        // Ocultar sugerencias al hacer clic fuera
        document.addEventListener("click", (e) => {
            if (!e.target.closest("#Usuario")) {
                sugerencias.classList.remove("show");
            }
        });

        // Eliminar registro
        document.querySelectorAll('.delete-link').forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                const href = link.getAttribute('href');

                swal.fire({
                    title: '¿Desea eliminar el cambio?',
                    text: 'Esta acción no se puede deshacer y eliminará los archivos del repo de manera permanente',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch("/SqlFiles/Delete", {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            },
                            body: JSON.stringify(id)
                        })
                        .then(async response => {
                            if (response.redirected) {
                                return { redirected: true, url: response.url };
                            }
                            return { redirected: false, data: await response.json() };
                        })
                        .then(result => {
                            if (result.redirected) {
                                window.location.href = result.url;
                            } else if (result.data?.success) {
                                if (result.data.redirectUrl) {
                                    window.location.href = result.data.redirectUrl;
                                } else {
                                    Swal.fire('Éxito', result.data.message, 'success').then(() => {
                                        window.location.reload();
                                    });
                                }
                            } else {
                                Swal.fire('Error', result.data?.message || 'Error desconocido', 'error');
                            }
                        })
                        .catch(error => {
                            Swal.fire('Error', 'Error de conexión', 'error');
                            console.error('Error:', error);
                        });
                    }
                });
            });
        });

        // Event listener para el botón de actualizar
        btnActualizarEstados?.addEventListener('click', actualizarTodosEstados);

        // Inicializar cuando el DOM esté listo
        document.addEventListener("DOMContentLoaded", function () {
            // Carga inicial única (sin polling posterior)
            cargaInicialEstados();

            console.log('Página cargada. El botón se habilitará cuando termine la carga inicial.');
        });
    </script>
}