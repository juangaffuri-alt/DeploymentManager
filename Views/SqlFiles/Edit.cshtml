        // Función que deberías llamar cuando termines de inyectar los resultados:
        function refreshLastModifiedInfo() {
            const items = Array.from(document.querySelectorAll(".search-result-item"));

            const maxParallel = 5;
            let running = 0;
            let index = 0;

            function runNext() {
                if (running >= maxParallel || index >= items.length)
                    return;

                const item = items[index++];
                running++;

                updateItem(item).finally(() => {
                    running--;
                    runNext();
                });

                runNext();
            }

            runNext();
        }

        async function updateItem(item) {
            const repoId = item.dataset.repoid;
            const path = item.dataset.path;

            const target = item.querySelector(".last-modified");
            if (!target) return;

            try {
                const response = await fetch(`/SqlFiles/GetLastCommitInfo?repositoryId=${repoId}&path=${encodeURIComponent(path)}`);
                const data = await response.json();

                if (!data.ok) {
                    target.textContent = "—";
                    return;
                }

                const date = new Date(data.date).toLocaleString();
                const avatarBase64 = await obtenerAvatarBase64(data.author, data.email, data.author);

                //const avatar = `https://dev.azure.com/YOURORG/_apis/GraphProfile/MemberAvatars/${encodeURIComponent(data.email)}?size=small`;

                target.innerHTML = `
                    <span style="display:flex;align-items:center;gap:6px;">
                        <img src="${avatarBase64}" style="width:22px;height:22px;border-radius:50%;">
                        <span>${data.author}</span>
                        <small class="text-muted">${date}</small>
                    </span>
                `;
            }
            catch (err) {
                console.error(err);
                target.textContent = "Error";
            }
        }
        async function obtenerAvatarBase64(directoryAlias, email, displayName) {
            const response = await fetch(`/api/Handler/imagen-devopsAd?directoryAlias=${encodeURIComponent(directoryAlias)}&email=${encodeURIComponent(email)}&displayName=${encodeURIComponent(displayName)}`);

            if (!response.ok)
                return null;

            const blob = await response.blob();

            return await blobToBase64(blob);
        }

        function blobToBase64(blob) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onloadend = () => resolve(reader.result);
                reader.onerror = reject;
                reader.readAsDataURL(blob);     // convierte a data:image/jpeg;base64,...
            });
        }
    </script>
