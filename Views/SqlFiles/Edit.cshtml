        function marcarArchivosModificadosAntesDeEnviar() {
            virtualFiles.forEach(function (file) {
                if (file._estado === 'nuevo' || file._estado === 'eliminado') {
                    return;
                }
                const contenidoOriginal = file.originalContent != null ? file.originalContent : file.content;
                const nombreOriginal = file.originalPath || file.name;
                if (file.content !== contenidoOriginal || file.name !== nombreOriginal) {
                    file._estado = 'modificado';
                }
            });
        }

        function handleFormSubmit(e) {
            // Solo permitir submit si es uno de los botones de acción válidos
            const submitter = e.submitter;
            const action = submitter ? submitter.getAttribute('value') : null;

            if (!action || (action !== 'save' && action !== 'save-and-release')) {
                e.preventDefault();
                return;
            }

            e.preventDefault();

            // Validar que hay archivos
            if (virtualFiles.length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Sin archivos',
                    text: 'Por favor agrega al menos un archivo o script',
                    confirmButtonText: 'Entendido'
                });
                return;
            }

            // Validar campos requeridos
            const requiredFields = [
                { name: 'Tipo', label: 'Tipo' },
                { name: 'Numero', label: 'Número' },
                { name: 'RepositoryId', label: 'Aplicativo' },
                { name: 'Descripcion', label: 'Descripción' }
            ];

            for (const field of requiredFields) {
                const input = document.querySelector(`[name="${field.name}"]`);
                if (!input || !input.value.trim() || input.value <= 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Campo requerido',
                        text: `Por favor completa el campo: ${field.label}`,
                        confirmButtonText: 'Entendido'
                    });
                    return;
                }
            }

            // Mostrar confirmación antes de guardar
            const actionText = action === 'save' ? 'guardar' : 'guardar y liberar';

            Swal.fire({
                title: '¿Confirmar acción?',
                text: `¿Estás seguro de que deseas ${actionText} este script?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: `Sí, ${actionText}`,
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    volcarEditorModalSiAbierto();
                    marcarArchivosModificadosAntesDeEnviar();
                    document.getElementById('JsonVirtualFiles').value = JSON.stringify(virtualFiles);
                    if (typeof window.serializeTablaTareas === 'function' && window.serializeTablaTareas() === false) {
                        return;
                    }

                    // Determinar acción
                    const form = e.target;
                    form.action = '/SqlFiles/EditScript';
                    if (action === 'save') {
                        document.getElementById('GeneratePR').value = false;
                    } else if (action === 'save-and-release') {
                        document.getElementById('GeneratePR').value = true;
                    }

                    // Mostrar loading
                    Swal.fire({
                        title: 'Procesando...',
                        text: 'Guardando el script, por favor espera',
                        allowOutsideClick: false,
                        showConfirmButton: false,
                        willOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    form.submit();
                }
            });
        }

