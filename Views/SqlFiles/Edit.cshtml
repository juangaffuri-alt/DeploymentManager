        async function processUploadedFile(file) {
            const content = await readFileContent(file);
            const parsed = parseStructureFromContent(content);


            const resultado = detectarModificaciones(content);

            // Filtrar claves con más de 2 ocurrencias
            const modificacionesMultiples = Object.entries(resultado)
                .filter(([clave, cantidad]) => cantidad >= 2)
                .map(([clave, cantidad]) => ({ tipo: clave, cantidad }));

            /*if (modificacionesMultiples.length > 0) {

                Swal.fire({
                    icon: 'warning',
                    title: 'Script inválido',
                    text: 'El archivo seleccionado contiene más de una sentencia de modificación',
                    confirmButtonText: 'Entendido'
                });
                return;
            }*/ 

            let fileName = file.name;
            let orig = 'upload';
            let estado = 'nuevo';
            if (parsed.name && parsed.type) {
                const fullName = `${parsed.schema}.${parsed.name}`;
                fileName = generateFileName(fullName, parsed.type);
                if (await fileExists(fileName)) {
                    // Mostrar loading
                    Swal.fire({
                        title: 'Procesando...',
                        text: 'Verificando nombre de archivo...',
                        allowOutsideClick: false,
                        showConfirmButton: false,
                        willOpen: () => {
                            Swal.showLoading();
                        }
                    });
                    fileName = await GetRealPath(fileName);
                    orig = 'devops';
                    estado = 'modificado';
                }
            }


            const virtualFile = {
                name: fileName,
                content: content,
                origin: orig,
                structureType: parsed.type,
                autoGeneratedFileName: fileName,
                parsedStructure: parsed,
                _estado: estado,
                _hash: await calculateHash(content)
            };

            addVirtualFile(virtualFile);
        }

        async function GetRealPath(fileName) {
            const repositoryId = document.querySelector('[name="RepositoryId"]').value;

            const response = await fetch('/sqlFiles/GetRealNamePath', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    repositoryId: repositoryId,
                    filePath: fileName
                })
            });

            if (response.ok) {
                const structure = await response.json();
                return structure.path;
            }
            return fileName;
        }

        function addVirtualFile(virtualFile) {
            // Verificar si ya existe un archivo con el mismo hash
            if (virtualFiles.some(f => f._hash === virtualFile._hash)) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Contenido duplicado',
                    text: 'Un archivo con el mismo contenido ya fue agregado a la lista',
                    confirmButtonText: 'Entendido'
                });
                return;
            }
            if (virtualFiles.some(f => f.name === virtualFile.name)) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Contenido duplicado',
                    text: 'El archivo seleccionado ya se encuentra en la lista',
                    confirmButtonText: 'Entendido'
                });
                return;
            }

            virtualFiles.push(virtualFile);
            renderVirtualFiles(virtualFiles, 'virtual-files-container');
            Swal.fire({
                icon: 'success',
                title: '¡Script agregado!',
                text: `La script "${virtualFile.name}" se agregó correctamente`,
                timer: 2000,
                showConfirmButton: false
            });
        }

        

        async function openFileModal(file, isNew = false) {
            currentEditingFile = file;

            const repositoryId = document.querySelector('[name="RepositoryId"]').value;

            if (!repositoryId) {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Aplicativo requerido',
                    text: 'Por favor selecciona un aplicativo primero',
                    confirmButtonText: 'Entendido'
                });
                return;
            }

            document.getElementById('modalTitle').textContent = isNew ? 'Nuevo Archivo' : 'Editar Archivo';

            const iconElement = document.getElementById('modalIcon');
            iconElement.innerHTML = getStructureIcon(file.structureType || 'sql');

            // Configurar contenido de los editores
            if (isNew) {
                // Para archivos nuevos, ambos editores muestran el mismo contenido inicialmente
                modalEditor.setValue(file.content);
                // originalEditor.setValue(file.content);

                // Para archivos nuevos, establecer originalContent
                if (!file.originalContent) {
                    file.originalContent = file.content;
                }
            } else {
                // Para archivos existentes
                if (file.content) {
                    modalEditor.setValue(file.content);
                    const readOnlyLines = file.requiredLines;

                } else {
                    modalEditor.setValue(file.content);
                }

                // El contenido original siempre viene de originalContent, o si no existe, del content inicial
                const originalContent = file.originalContent || file.content;
                //originalEditor.setValue(originalContent);

                // Asegurar que originalContent esté guardado
                if (!file.originalContent) {
                    file.originalContent = file.content;
                }
            }

            modalEditor.clearSelection();
            //originalEditor.clearSelection();


            const modal = new bootstrap.Modal(document.getElementById('modalVirtualFile'));
            modal.show();

            // Redimensionar editores cuando el modal esté completamente mostrado
            modal._element.addEventListener('shown.bs.modal', function () {
                modalEditor.resize();
                //originalEditor.resize();
            });
        }

        

