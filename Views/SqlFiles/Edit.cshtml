        async function searchStructures() {
            const structureType = document.getElementById('structureType').value;
            const searchTerm = document.getElementById('searchInput').value;
            const repositoryId = document.querySelector('[name="RepositoryId"]').value;

            if (!repositoryId) {
                await Swal.fire({
                    icon: 'warning',
                    title: 'Aplicativo requerido',
                    text: 'Por favor selecciona un aplicativo primero',
                    confirmButtonText: 'Entendido'
                });
                return;
            }

            showLoadingSpinner(true);

            try {
                const response = await fetch('/sqlFiles/SearchStructures', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        repositoryId: repositoryId,
                        structureType: structureType,
                        searchTerm: searchTerm
                    })
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const structures = await response.json();
                displaySearchResults(structures);
            } catch (error) {
                console.error('Error searching structures:', error);
                await Swal.fire({
                    icon: 'error',
                    title: 'Error de búsqueda',
                    text: 'Ocurrió un error al buscar las estructuras. Por favor intenta nuevamente.',
                    confirmButtonText: 'Entendido'
                });
            } finally {
                showLoadingSpinner(false);
            }
        }

        function displaySearchResults(structures) {
            const resultsContainer = document.getElementById('searchResults');
            const repositoryId = document.querySelector('[name="RepositoryId"]').value;

            if (structures.length === 0) {
                resultsContainer.innerHTML = `
                                                                                                    <div class="text-center py-4 text-muted">
                                                                                                        <i class="fas fa-search fa-3x mb-3"></i>
                                                                                                        <p>No se encontraron estructuras con los criterios especificados</p>
                                                                                                    </div>
                                                                                                `;
                return;
            }

            const resultsHtml = structures.map(structure => `
                                                                                                   <div class="card search-result-item mb-2" data-structure='${JSON.stringify(structure)}' data-repoid="${repositoryId}" data-path="${structure.path}" title="Agregar al cambio">
                                                                                                    <div class="card-body py-2">
                                                                                                        <div class="d-flex justify-content-between align-items-center">
                                                                                                            <div>
                                                                                                                <h6 class="mb-1">${getStructureIcon(structure.type)} ${structure.name}</h6>
                                                                                                                <small class="text-muted">${structure.path}</small>
                                                                                                            </div>
                                                                                                            <div class="search-meta">
                                                                                                                <span class="badge bg-primary structure-type-badge">${structure.type}</span>
                                                                                                                <small class="text-muted ms-2 last-modified">Cargando datos de su última versión...</small>
                                                                                                            </div>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                </div>
                                                                                            `).join('');

            resultsContainer.innerHTML = resultsHtml;
            refreshLastModifiedInfo();
            // Agregar event listeners a los resultados
            resultsContainer.querySelectorAll('.search-result-item').forEach(item => {
                item.addEventListener('click', function () {
                    const structure = JSON.parse(this.dataset.structure);
                    loadStructureFromDevOps(structure);
                });
            });
        }

        async function loadStructureFromDevOps(structure) {
            try {
                const repositoryId = document.querySelector('[name="RepositoryId"]').value;

                const response = await fetch('/sqlFiles/GetStructureContent', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        repositoryId: repositoryId,
                        filePath: structure.path
                    })
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const content = await response.text();
                const parsed = parseStructureFromContent(content);

                // --------------------- content for edit -----------------------------------
                const responseForEdit = await fetch('/sqlFiles/GetContentForEdit', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        content: content,
                        type: structure.type,
                        schema: parsed.schema,
                        name: parsed.name || structure.name
                    })
                });

                if (!responseForEdit.ok) {
                    throw new Error(`HTTP error! status: ${responseForEdit.status}`);
                }
                const sqlTemplate = await responseForEdit.json();
                //const contentForEdit = await responseForEdit.text();
                // --------------------- content for edit -----------------------------------


                const fullName = `${parsed.schema || 'dbo'}.${parsed.name || structure.name}`;
                const fileName = generateFileName(fullName, structure.type);

                const virtualFile = {
                    name: structure.path,
                    //content: sqlTemplate.content,
                    content:content,
                    origin: 'devops',
                    originalPath: structure.path,
                    structureType: structure.type,
                    autoGeneratedFileName: fileName,
                    parsedStructure: parsed,
                    requiredLines: sqlTemplate.requiredLines,
                    _estado: "modificado",
                    _hash: await calculateHash(content)
                };

                addVirtualFile(virtualFile);



            } catch (error) {
                console.error('Error loading structure:', error);
                await Swal.fire({
                    icon: 'error',
                    title: 'Error al cargar estructura',
                    text: 'No se pudo cargar la estructura desde DevOps. Por favor intenta nuevamente.',
                    confirmButtonText: 'Entendido'
                });
            }
        }

        async function loadTemplate2(templateType, filePath) {
            const response = await fetch(`/sqlFiles/GetTemplate?filePath=${filePath}`, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                }
            });

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }            
            const content = await response.text();
            const coincidencias = virtualFiles.filter(f => f.templateType === templateType);
            const cantidad = coincidencias.length;
            const fileName = `${templateType.toLowerCase()}_template${cantidad>0?'_'+cantidad:''}.sql`;

            const virtualFile = {
                name: fileName,
                content: content,
                origin: 'template',
                templateType: templateType,
                _estado: "nuevo",
                _hash: calculateHash(content)
            };

            openFileModal(virtualFile, true);
        }

