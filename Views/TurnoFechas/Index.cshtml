@model PasadorScript.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Sistema de Turnos - Entornos";
    var nombreUsuario = User.Identity.Name;
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row pt-2 pb-4">
        <div>
            <h3 class="fw-bold mb-3">Reserva y solicitud de fechas</h3>
        </div>
        <div class="ms-md-auto py-2 py-md-0">
            <!-- Botón para actualizar manualmente - inicialmente deshabilitado -->
            <button type="button" id="btnActualizarEstados" class="btn btn-info ms-2" onclick="location.reload()">
                <span class="btn-label">
                    <i class="fas fa-sync-alt"></i>
                </span>
                <span id="btnTexto">Actualizar</span>
            </button>
        </div>
    </div>
    

    <!-- Alertas -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Mis Turnos Activos -->
    @if (Model.MisTurnos != null && Model.MisTurnos.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-info shadow">
                    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-user-clock me-2"></i>Mis Turnos Activos</h5>
                        <span class="badge bg-light text-dark">@Model.MisTurnos.Count turno(s)</span>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            @foreach (var turno in Model.MisTurnos)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100 @(turno.EsMiTurno ? "border-success" : "border-warning")">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-3">
                                                <div>
                                                    <span class="badge bg-@turno.EntornoColor fs-6">
                                                        <i class="@(turno.EntornoNombre == "DESA" ? "fas fa-laptop-code" : turno.EntornoNombre == "QA" ? "fas fa-vial" : "fas fa-database") me-2"></i>
                                                        @turno.EntornoNombre
                                                    </span>
                                                </div>
                                                @if (turno.EsMiTurno)
                                                {
                                                    <span class="badge bg-success"><i class="fas fa-play me-1"></i>EN PROCESO</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>EN COLA</span>
                                                }
                                            </div>
                                            <div class="mb-3">
                                                <div class="d-flex align-items-center mb-2">
                                                    <i class="fas fa-calendar-alt text-primary me-2" style="width:20px;"></i>
                                                    <span><strong>Nueva fecha:</strong> <span class="fw-bold text-primary">@turno.FechaSolicitada.ToString("dd/MM/yyyy")</span></span>
                                                </div>
                                                <div class="d-flex align-items-center mb-2">
                                                    <i class="fas fa-hourglass-half text-primary me-2" style="width:20px;"></i>
                                                    <span><strong>Duración:</strong> @turno.MinutosDuracion min</span>
                                                </div>
                                                <div class="d-flex align-items-center mb-2">
                                                    <i class="fas fa-clock text-primary me-2" style="width:20px;"></i>
                                                    <span><strong>Solicitado:</strong> @turno.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</span>
                                                </div>
                                                @if (turno.EsMiTurno)
                                                {
                                                    if (!turno.Ejecutado && turno.MinutosParaEjecucionRestantes.HasValue)
                                                    {
                                                        <div class="d-flex align-items-center mb-2">
                                                            <i class="fas fa-hourglass-start text-primary me-2" style="width:20px;"></i>
                                                            <span><strong>Ejecución en:</strong> <span class="@(turno.MinutosParaEjecucionRestantes < 5 ? "text-danger fw-bold" : "text-success")">@turno.MinutosParaEjecucionRestantes min</span></span>
                                                        </div>
                                                    }
                                                    else if (turno.Ejecutado && turno.MinutosRestantes.HasValue)
                                                    {
                                                        <div class="d-flex align-items-center mb-2">
                                                            <i class="fas fa-hourglass-end text-primary me-2" style="width:20px;"></i>
                                                            <span><strong>Restantes:</strong> <span class="@(turno.MinutosRestantes < 5 ? "text-danger fw-bold" : "")">@turno.MinutosRestantes min</span></span>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-items-center mb-2">
                                                        <i class="fas fa-list-ol text-primary me-2" style="width:20px;"></i>
                                                        <span><strong>Posición:</strong> <span class="badge bg-secondary">#@turno.PosicionCola</span></span>
                                                    </div>
                                                    <div class="d-flex align-items-center mb-2">
                                                        <i class="fas fa-hourglass-start text-primary me-2" style="width:20px;"></i>
                                                        <span><strong>Espera:</strong> @turno.TiempoEspera min</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(turno.Motivo))
                                                {
                                                    <div class="mt-2 p-2 bg-light rounded small">
                                                        <i class="fas fa-comment text-muted me-1"></i> @turno.Motivo
                                                    </div>
                                                }
                                            </div>
                                            <a asp-action="MiTurno" asp-route-id="@turno.Id" class="btn @(turno.EsMiTurno ? "btn-success" : "btn-outline-primary") w-100">
                                                @if (turno.EsMiTurno)
                                                {
                                                    <i class="fas fa-arrow-right me-2">Gestionar Cambio</i>
                                                }
                                                else
                                                {

                                                    <i class="fas fa-eye me-2">Ver Estado</i>
                                                }
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Entornos Disponibles -->
    <div class="row mb-4"><div class="col-12"><h4 class="mb-3"><i class="fas fa-server me-2"></i>Entornos Disponibles</h4></div></div>
    <div class="row">
        @foreach (var entorno in Model.Entornos)
        {
            var estado = Model.EstadosPorEntorno[entorno.Id];
            <div class="col-xl-6 col-xxl-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-@entorno.Color text-white py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="mb-0"><i class="@entorno.Icono me-2"></i>@entorno.Nombre</h4>
                                <small class="text-white-50">@entorno.Descripcion</small>
                            </div>
                            <div class="text-end">
                                <div class="small text-white-50">
                                    <i class="fas fa-calendar-day me-1"></i> Actual: @(estado.FechaActual?.ToString("dd/MM/yyyy") ?? "N/D")
                                </div>
                                <span class="badge bg-light text-dark fs-6 d-block mb-1 mt-1">
                                    <i class="fas fa-users me-1"></i> @estado.TotalEnCola
                                </span>
                                @if (estado.TurnoActivo != null)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="fas fa-play me-1"></i> En ejecución
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (estado.TurnoActivo != null)
                        {
                            <div class="alert alert-warning mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div>
                                        <i class="fas fa-user-cog me-2"></i>
                                        <strong>@estado.TurnoActivo.Usuario</strong>
                                        <span class="badge bg-danger ms-2">
                                            <i class="fas fa-hourglass-half me-1"></i> @estado.TurnoActivo.MinutosRestantes min
                                        </span>
                                    </div>
                                </div>

                                <!-- Mostrar nueva fecha (siempre) -->
                                <div class="bg-light p-2 rounded small">
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted">Nueva fecha:</span>
                                        <span class="fw-bold text-primary">@estado.TurnoActivo.FechaSolicitada.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    @if (estado.TurnoActivo.Ejecutado)
                                    {
                                        <small class="text-success d-block mt-1"><i class="fas fa-check-circle"></i> Cambio ejecutado</small>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(estado.TurnoActivo.Motivo))
                                {
                                    <small class="text-muted d-block mt-2">
                                        <i class="fas fa-comment me-1"></i> @estado.TurnoActivo.Motivo
                                    </small>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success mb-3">
                                <i class="fas fa-check-circle me-2"></i> Entorno Libre
                            </div>
                        }
                        <h6 class="border-bottom pb-2">
                            <i class="fas fa-list-ol me-2"></i>Solicitudes Pendientes @if(estado.Cola.Any()){
                            <span class="badge bg-secondary rounded-pill float-end">@estado.Cola.Count</span>
                        }
                    </h6>
                    @if (estado.Cola.Any())
                    {
                        <div class="list-group list-group-flush mb-3">
                            @foreach (var item in estado.Cola)
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div style="width:100%;">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <span class="badge bg-secondary rounded-pill me-2">#@item.Posicion</span>
                                                    <span><i class="fas fa-user"></i> <strong>@item.Usuario</strong></span>
                                                </div>
                                                <small class="text-muted"><i class="far fa-clock"></i> @item.MinutosEstimados min</small>
                                            </div>
                                            <div class="mt-2 ps-4 small">
                                                <i class="fas fa-calendar-alt text-muted me-2"></i>
                                                <span class="text-muted">Nueva fecha:</span>
                                                <span class="ms-2 fw-bold text-primary">@item.FechaSolicitada.ToString("dd/MM/yyyy")</span>
                                            </div>
                                            <div class="mt-2 ps-4 d-flex justify-content-between small">
                                                <span class="text-muted"><i class="fas fa-hourglass-start"></i> Espera: @item.TiempoEsperaEstimado min</span>
                                                @if (!string.IsNullOrEmpty(item.Motivo))
                                                {
                                                    <span class="text-muted" title="@item.Motivo"><i class="fas fa-comment"></i></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3"><i class="fas fa-inbox me-2"></i>No hay solicitudes en cola</p>
                    }
                </div>
                <div class="card-footer bg-transparent">
                    @if (Model.MisTurnos.Any(mt => mt.EntornoId == entorno.Id))
                    {
                        var miTurno = Model.MisTurnos.First(mt => mt.EntornoId == entorno.Id);
                        <div class="d-grid"><a asp-action="MiTurno" asp-route-id="@miTurno.Id" class="btn btn-outline-@entorno.Color"><i class="fas fa-eye me-2"></i>Ver mi turno en @entorno.Nombre</a></div>
                    }
                    else
                    {
                        <button class="btn btn-@entorno.Color w-100" onclick="mostrarModalSolicitud(@entorno.Id, '@entorno.Nombre')"><i class="fas fa-plus-circle me-2"></i>Solicitar Cambio de Fecha</button>
                    }
                </div>
            </div>
        </div>
                }
    </div>
</div>

<!-- Modal de Solicitud -->
<div class="modal fade" id="modalSolicitud" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-calendar-plus me-2"></i>Solicitar Cambio de Fecha - <span id="entornoNombre"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Solicitar" method="post" id="formSolicitud">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="entornoId" id="entornoId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold"><i class="fas fa-calendar-plus me-2 text-primary"></i>Nueva fecha:</label>
                        <input type="date" name="fechaSolicitada" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold"><i class="fas fa-hourglass-start me-2 text-primary"></i>Minutos hasta ejecución (Y):</label>
                        <input type="number" name="minutosParaEjecucion" class="form-control" min="1" max="480" value="5" required />
                        <small class="text-muted">Tiempo que esperarás antes de que se ejecute el cambio</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold"><i class="fas fa-hourglass-half me-2 text-primary"></i>Minutos de duración (Z):</label>
                        <input type="number" name="minutosDuracion" class="form-control" min="1" max="480" value="5" required />
                        <small class="text-muted">Tiempo que necesitas después de la ejecución</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold"><i class="fas fa-comment me-2 text-primary"></i>Motivo (opcional):</label>
                        <textarea name="motivo" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Solicitar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let refreshTimeout;

        function programarRefresco() {
            refreshTimeout = setTimeout(function() { location.reload(); }, 30000);
        }
        programarRefresco();

        const modalSolicitud = document.getElementById('modalSolicitud');
        modalSolicitud.addEventListener('show.bs.modal', function() { clearTimeout(refreshTimeout); });
        modalSolicitud.addEventListener('hidden.bs.modal', function() { programarRefresco(); });

        function mostrarModalSolicitud(entornoId, entornoNombre) {
            document.getElementById('entornoId').value = entornoId;
            document.getElementById('entornoNombre').textContent = entornoNombre;
            new bootstrap.Modal(modalSolicitud).show();
        }

        // Envío AJAX del formulario
        document.getElementById('formSolicitud').addEventListener('submit', async function(e) {
            e.preventDefault();
            const form = this;
            const formData = new FormData(form);
            const modal = bootstrap.Modal.getInstance(modalSolicitud);
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;

            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Procesando...';
            submitBtn.disabled = true;

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const contentType = response.headers.get('content-type');
                if (!contentType || !contentType.includes('application/json')) {
                    throw new Error('Respuesta no válida del servidor');
                }

                const result = await response.json();

                if (result.success) {
                    modal.hide();
                    const alerta = `<div class="alert alert-success alert-dismissible fade show" role="alert"><i class="fas fa-check-circle"></i> ${result.message}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>`;
                    document.querySelector('.container-fluid').insertAdjacentHTML('afterbegin', alerta);
                    setTimeout(() => location.reload(), 1000);
                } else {
                    alert(result.message);
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error de comunicación con el servidor.');
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        });
    </script>
}