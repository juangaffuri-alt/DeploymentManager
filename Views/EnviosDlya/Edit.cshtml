@section Scripts {
    <partial name="_TablaTareasScripts" />
    <script src="~/js/EnviosDlya.js"></script>
    <script>

        // Inicialización
        document.addEventListener("DOMContentLoaded", async (e) => {
            const form = document.getElementById("form-virtual-files");

            form.addEventListener("submit", async function (e) {
                e.preventDefault();
                const submitter = e.submitter;

                if (submitter && submitter.hasAttribute("formaction")) {
                    form.action = submitter.getAttribute("formaction");
                }

                if (!$(form).valid() || virtualFiles.length <= 0) {
                    if ($(form).valid() && virtualFiles.length <= 0) {
                        Swal.fire({
                            title: "Error de validación",
                            text: "Por favor, adjuntá un archivo o agregalo desde un template.",
                            icon: "warning"
                        });
                    }
                    return;
                }

                // Mostrar loading
                Swal.fire({
                    title: 'Procesando...',
                    text: 'Guardando el archivos, por favor espera',
                    allowOutsideClick: false,
                    showConfirmButton: false,
                    willOpen: () => {
                        Swal.showLoading();
                    }
                });

                // Preparar datos de virtualFiles con el contenido y la ruta procesada
                const virtualFilesData = virtualFiles.map(file => ({
                    name: file.name,
                    content: file.content,
                    rutaOriginal: file.rutaOriginal,
                    displayName: file.displayName,
                    _estado: file._estado,
                    _hash: file._hash,
                    _origenZip: file._origenZip || false,
                    _tamaño: file._tamaño,
                    _fecha: file._fecha,
                    _esBinario: file._esBinario || false
                }));

                document.getElementById("JsonVirtualFiles").value = JSON.stringify(virtualFilesData);
                if (typeof window.serializeTablaTareas === 'function' && window.serializeTablaTareas() === false) {
                    return;
                }
                form.submit();
            });

            // Cargar archivos existentes del modelo
        @foreach (var file in Model.Files)
        {
            var content = file.Content;//await _serviciosAzure.GetFileContentAsync(Model.RepositoryId, file.IdFileAzure, true, Model.FolderAndBranchNameDesa);
            //var encodedContent = Encoding.UTF8.GetString(Convert.FromBase64String(file.Content));//JavaScriptEncoder.Default.Encode(content ?? "");
            var encodedContent = JavaScriptEncoder.Default.Encode(content ?? "");
            <text>
                var contenido = `@Html.Raw(encodedContent)`;
                var nombre = "@file.FileName";
                // var encodContent = "@content";
                var hash = await calcularHashDesdeContenido(contenido);
                virtualFiles.push({
                    displayName: "@file.DisplayName",
                    name: nombre,
                    content: contenido,
                    rutaOriginal: "@file.IdFileAzure",
                    origin: "devopsdlya",
                    _hash: hash,
                    _tamaño: contenido.length,
                    _fecha: new Date("@file.FechaCreacion.ToString("yyyy-MM-ddTHH:mm:ss")").toISOString(),
                    _esBinario: false
                });

                dropzoneHashes.push(hash);
            </text>
        }

                renderVirtualFiles();

            // Inicializar Dropzone
            const dropTarget = document.getElementById("DropzoneArea");

            if (!dropTarget) {
                console.error("El elemento #DropzoneArea no existe.");
                return;
            }

            // Destruir instancia existente si existe
            try {
                const instanciaExistente = Dropzone.forElement("#DropzoneArea");
                if (instanciaExistente) {
                    instanciaExistente.destroy();
                }
            } catch (e) {
                // Ignorar error si no existe
            }

            const dropzone = new Dropzone(dropTarget, {
                url: "/no-se-usa",
                autoProcessQueue: false,
                paramName: "file",
                clickable: "#btnAddFiles",
                maxFilesize: 2,
                acceptedFiles: ".zip,.rar,.7z",
                dictDefaultMessage: "Arrastrá archivos comprimidos o hacé clic para subir",
                previewsContainer: false,
                createImageThumbnails: false,
                addRemoveLinks: false,
                init: function () {
                    const dz = this;

                    this.on("addedfile", async function (file) {
                        const hash = await calcularHashArchivo(file);

                        if (dropzoneHashes.includes(hash)) {
                            dz.removeFile(file);
                            Swal.fire({
                                title: "Archivo ya subido!",
                                text: "El archivo ya se encuentra en la lista!",
                                icon: "warning"
                            });
                            return;
                        }

                        file._customHash = hash;
                        dropzoneHashes.push(hash);

                        await setPreview(file);
                    });
                }
            });

            document.getElementById("btnAddFiles").addEventListener("click", function (e) {
                e.preventDefault();
            });
        });
    </script>
}

