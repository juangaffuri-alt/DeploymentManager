@model PasadorScript.ViewModels.MonacoDiffModel
@using System.Text.Json

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diferencias: @Model.FileName</title>

    <!-- Solo estilos mínimos -->
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            font-size: 14px;
        }

        .iframe-header {
            background: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
            padding: 12px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .file-info {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .file-name {
            font-weight: 600;
            color: #212529;
        }

        .file-path {
            color: #6c757d;
            font-size: 12px;
            max-width: 300px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .controls {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        .diff-stats {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 600;
        }

        .badge-add {
            background: #d4edda;
            color: #155724;
        }

        .badge-del {
            background: #f8d7da;
            color: #721c24;
        }

        .btn {
            padding: 6px 12px;
            border: 1px solid #6c757d;
            border-radius: 4px;
            background: white;
            color: #6c757d;
            cursor: pointer;
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

            .btn:hover {
                background: #f8f9fa;
            }

            .btn.active {
                background: #0d6efd;
                color: white;
                border-color: #0d6efd;
            }

            .btn.disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }

        .editor-container {
            width: 100%;
            height: calc(100vh - 60px); /* Altura total menos header */
        }

        .loading {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            flex-direction: column;
        }

        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #0d6efd;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        @@media (max-width: 768px) {
            .controls {
                flex-direction: column;
                align-items: flex-start;
            }

            .file-path {
                max-width: 200px;
            }
        }
    </style>
</head>
<body>
    <!-- Header compacto -->
    <div class="iframe-header">
        <div class="file-info">
            <span class="file-name">@Model.FileName</span>
            <span class="file-path">@Model.FilePath</span>
        </div>

        <div class="controls">
            <div class="diff-stats">
                <span class="badge badge-add">+@Model.AddedLines</span>
                <span class="badge badge-del">-@Model.DeletedLines</span>
            </div>

            <div class="btn-group">
                <button class="btn" onclick="changeViewMode('split')" id="splitBtn" title="Vista lado a lado">
                    ⚏ Split
                </button>
                <button class="btn" onclick="changeViewMode('inline')" id="inlineBtn" title="Vista unificada">
                    ☰ Inline
                </button>
            </div>

            <button class="btn" onclick="toggleLineNumbers()" id="lineNumbersBtn" title="Mostrar/ocultar números de línea">
                # Líneas
            </button>

            <div class="nav-buttons">
                <button class="btn" onclick="goToPrevDiff()" title="Diferencia anterior">
                    ← Anterior
                </button>
                <button class="btn" onclick="goToNextDiff()" title="Siguiente diferencia">
                    → Siguiente
                </button>
            </div>
        </div>
    </div>

    <!-- Container para Monaco Editor -->
    <div class="editor-container" id="editorContainer">
        <div class="loading" id="loading">
            <div class="spinner"></div>
            <p style="margin-top: 1rem;">Cargando editor de código...</p>
        </div>
    </div>

    <!-- Monaco Editor desde CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.39.0/min/vs/loader.min.js"></script>

    <script>
        // Datos del modelo
        const editorData = {
            originalContent: @Html.Raw(Json.Serialize(Model.OriginalContent ?? "")),
            modifiedContent: @Html.Raw(Json.Serialize(Model.ModifiedContent ?? "")),
            language: '@(Model.Language ?? "sql")',
            fileName: '@Model.FileName',
            filePath: '@Model.FilePath'
        };

        let editor = null;
        let currentViewMode = 'split';
        let showLineNumbers = true;

        // Configurar Monaco
        require.config({
            paths: {
                'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.39.0/min/vs'
            }
        });

        // Inicializar editor
        require(['vs/editor/editor.main'], function() {
            try {
                console.log('Monaco Editor cargado');

                const container = document.getElementById('editorContainer');
                const loading = document.getElementById('loading');

                // Crear editor diff
                editor = monaco.editor.createDiffEditor(container, {
                    theme: 'vs',
                    language: editorData.language,
                    automaticLayout: true,
                    renderSideBySide: currentViewMode === 'split',
                    lineNumbers: showLineNumbers ? 'on' : 'off',
                    minimap: { enabled: false },
                    scrollBeyondLastLine: false,
                    wordWrap: 'on',
                    diffWordWrap: 'on',
                    renderSideBySideInlineBreakpoint: 0
                });

                // Configurar modelos
                const originalModel = monaco.editor.createModel(
                    editorData.originalContent,
                    editorData.language
                );

                const modifiedModel = monaco.editor.createModel(
                    editorData.modifiedContent,
                    editorData.language
                );

                editor.setModel({
                    original: originalModel,
                    modified: modifiedModel
                });

                // Ocultar loading
                loading.style.display = 'none';

                console.log('Editor inicializado correctamente');

                // Notificar al padre que estamos listos (si estamos en iframe)
                if (window.parent && window.parent !== window) {
                    window.parent.postMessage({
                        type: 'monacoReady',
                        height: document.body.scrollHeight
                    }, '*');
                }

            } catch (error) {
                console.error('Error al inicializar Monaco:', error);
                document.getElementById('loading').innerHTML =
                    '<div style="padding: 20px; color: #dc3545;">' +
                    '<p>Error al cargar el editor:</p>' +
                    '<p>' + error.message + '</p>' +
                    '</div>';
            }
        });

        // Funciones de control
        function changeViewMode(mode) {
            if (!editor) return;

            currentViewMode = mode;
            editor.updateOptions({
                renderSideBySide: mode === 'split'
            });

            // Actualizar botones
            document.getElementById('splitBtn').classList.toggle('active', mode === 'split');
            document.getElementById('inlineBtn').classList.toggle('active', mode === 'inline');
        }

        function toggleLineNumbers() {
            if (!editor) return;

            showLineNumbers = !showLineNumbers;
            editor.updateOptions({
                lineNumbers: showLineNumbers ? 'on' : 'off'
            });

            // Actualizar botón
            const btn = document.getElementById('lineNumbersBtn');
            btn.classList.toggle('active', showLineNumbers);
        }

        function goToNextDiff() {
            if (!editor) return;
            editor.getAction('editor.action.diffReview.next').run();
        }

        function goToPrevDiff() {
            if (!editor) return;
            editor.getAction('editor.action.diffReview.prev').run();
        }

        // Shortcuts de teclado
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey || e.metaKey) {
                switch (e.key) {
                    case 'ArrowDown':
                        e.preventDefault();
                        goToNextDiff();
                        break;
                    case 'ArrowUp':
                        e.preventDefault();
                        goToPrevDiff();
                        break;
                }
            }
        });

        // Redimensionar editor cuando cambie el tamaño de la ventana
        window.addEventListener('resize', function() {
            if (editor) {
                editor.layout();
            }
        });

        // Inicializar estado de botones
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('splitBtn').classList.add('active');
            document.getElementById('lineNumbersBtn').classList.add('active');
        });
    </script>
</body>
</html>